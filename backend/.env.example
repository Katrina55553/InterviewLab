# 数据库配置（Docker 内使用服务名 postgres，本地开发用 localhost）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/resume_agent

# Redis 配置
REDIS_URL=redis://redis:6379/0

# 可选 GitHub Token：每日同步仓库 star / fork，公开仓库可留空。
GITHUB_TOKEN=

# LLM API（OpenAI 兼容格式，支持 DeepSeek 等第三方）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MODEL_LIGHT=deepseek-chat
LLM_MODEL_HEAVY=deepseek-reasoner
# 普通业务使用每个账户在「AI 设置」保存的个人凭据，不回退到以上平台 Key。
# 用户服务地址仅允许这些完整 Base URL 的 HTTPS 443；新增兼容服务需显式加入可信地址。
USER_LLM_ALLOWED_BASE_URLS=https://api.deepseek.com,https://api.deepseek.com/v1,https://api.openai.com/v1,https://openrouter.ai/api/v1,https://api.siliconflow.cn/v1,https://dashscope.aliyuncs.com/compatible-mode/v1,https://api.moonshot.cn/v1,https://open.bigmodel.cn/api/paas/v4
# ChatGPT 订阅：本地动态注册使用 127.0.0.1；远程部署可手动粘贴最终回调地址。
# 使用已注册的公开 Web OAuth 客户端时，同时填写客户端 ID 与精确注册的 HTTPS 回调地址。
USER_LLM_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/settings/ai/oauth/callback
USER_LLM_OAUTH_CLIENT_ID=

# 安全配置
SECRET_KEY=change-me-in-production

# 新平台：真实模式默认开启。仅在显式体验规则流程时设为 true。
PLATFORM_DEMO_MODE=false
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=168
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=4
AI_COMMAND_LEASE_SECONDS=150
# 各实例本地上限 + 同一实际 API Key 的 PostgreSQL 共享许可
AI_MAX_WAITERS=16
AI_WAIT_SECONDS=5
AI_BACKGROUND_CONCURRENCY=2
AI_VISION_CONCURRENCY=1
AI_PROVIDER_CONCURRENCY=8
AI_INTERACTIVE_RESERVED_PERMITS=2
AI_TOOL_CONCURRENCY=2
AI_MAX_OUTPUT_TOKENS=4096
AI_CIRCUIT_MIN_CALLS=10
AI_CIRCUIT_OPEN_SECONDS=30
AI_UNKNOWN_LIMIT=3
PARSER_PROCESSES=2
MEDIA_MAX_CONNECTIONS=8
OUTBOX_REDELIVER_SECONDS=60
# Compose 为 worker/dispatcher/inspector 单独覆盖角色。
SERVICE_ROLE=backend

# 可选讯飞实时转写大模型 / 长文本 TTS（各产品需开通）
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_ASR_URL=wss://office-api-ast-dx.iflyaisol.com/ast/communicate/v1
XFYUN_TTS_VOICE=x4_mingge
MEDIA_STORAGE_DIR=uploads/media

# CORS 配置（逗号分隔）
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Celery 配置
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 文件上传配置
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt

# 限流配置
RATE_LIMIT_PER_MINUTE=60
TOKEN_QUOTA_PER_USER=100000

# 日志级别
LOG_LEVEL=INFO

# 环境
# 生产设 production；SECRET_KEY 必须为至少32字符的稳定随机值。
# 已有凭据不能通过直接替换密钥迁移；见 docs/engineering-operations.md。
ENVIRONMENT=development
